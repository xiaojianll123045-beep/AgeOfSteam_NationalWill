<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>bin\Win64_Shipping_Client</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace>FeudalInternalAffairs</RootNamespace>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>None</DebugType>
    <!-- 游戏 Modules 目录: 只用于引用同级的 UIExtenderEx / Harmony。
         换机器时改这里, 或命令行 -p:GameModulesDir=... 覆盖 -->
    <GameModulesDir Condition="'$(GameModulesDir)'==''">E:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord\Modules</GameModulesDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bannerlord.ReferenceAssemblies.Core" Version="1.4.7.117484" PrivateAssets="all" />
    <PackageReference Include="Bannerlord.ReferenceAssemblies.Native" Version="1.4.7.117484" PrivateAssets="all" />
    <PackageReference Include="Bannerlord.ReferenceAssemblies.Sandbox" Version="1.4.7.117484" PrivateAssets="all" />
    <PackageReference Include="Bannerlord.ReferenceAssemblies.StoryMode" Version="1.4.7.117484" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.2.2" PrivateAssets="all" />
    <Reference Include="Bannerlord.UIExtenderEx">
      <HintPath>$(GameModulesDir)\Bannerlord.UIExtenderEx\bin\Win64_Shipping_Client\Bannerlord.UIExtenderEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameModulesDir)\Bannerlord.Harmony\bin\Win64_Shipping_Client\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
