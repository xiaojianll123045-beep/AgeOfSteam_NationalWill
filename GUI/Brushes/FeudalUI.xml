<Brushes>
  <Brush Name="Fia.Panel">
    <Layers>
      <BrushLayer Name="Default" Sprite="fia_ui_frame" ExtendLeft="48" ExtendTop="48" ExtendRight="48" ExtendBottom="48" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" AlphaFactor="1" />
      </Style>
    </Styles>
  </Brush>
  <Brush Name="Fia.PanelLite">
    <Layers>
      <BrushLayer Name="Default" Sprite="fia_ui_frame_lite" ExtendLeft="44" ExtendTop="44" ExtendRight="44" ExtendBottom="44" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" AlphaFactor="1" />
