  <Brush Name="Fia.Button">
    <Layers>
      <BrushLayer Name="Default" Sprite="fia_ui_button" ExtendLeft="14" ExtendTop="10" ExtendRight="14" ExtendBottom="10" />
      <BrushLayer Name="HoverLayer" Sprite="fia_ui_button_hover" ExtendLeft="14" ExtendTop="10" ExtendRight="14" ExtendBottom="10" />
      <BrushLayer Name="PressLayer" Sprite="fia_ui_button_press" ExtendLeft="14" ExtendTop="10" ExtendRight="14" ExtendBottom="10" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" AlphaFactor="1" />
        <BrushLayer Name="HoverLayer" IsHidden="true" />
        <BrushLayer Name="PressLayer" IsHidden="true" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" IsHidden="true" />
        <BrushLayer Name="HoverLayer" AlphaFactor="1" />
        <BrushLayer Name="PressLayer" IsHidden="true" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" IsHidden="true" />
        <BrushLayer Name="HoverLayer" IsHidden="true" />
        <BrushLayer Name="PressLayer" AlphaFactor="1" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" AlphaFactor="1" SaturationFactor="-50" ValueFactor="-50" />
        <BrushLayer Name="HoverLayer" IsHidden="true" />
        <BrushLayer Name="PressLayer" IsHidden="true" />
      </Style>
    </Styles>
  </Brush>
