<Prefab>
  <Constants>
  </Constants>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

        <!-- ===== 军团操作(v4.104): 解散军团 / 命令某人出军团 ===== -->
        <BrushWidget WidthSizePolicy="Fixed" SuggestedWidth="560" HeightSizePolicy="StretchToParent"
                HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="@PanelOffset" Brush="ArmyManagement.Panel.Left">
          <Children>

            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    MarginLeft="6" MarginRight="6" MarginTop="6" MarginBottom="6"
                    Sprite="BlankWhiteSquare" Color="#0D0A07F7" />

            <!-- 标题栏 -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="62" VerticalAlignment="Top"
                    MarginTop="14" MarginLeft="14" MarginRight="14" Sprite="BlankWhiteSquare" Color="#00000066">
              <Children>
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="40" SuggestedHeight="40"
                        HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="16" Sprite="fia_cat_military" />
                <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="360" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                            MarginLeft="64" Brush="MapTextBrushGal" Brush.FontSize="24" Brush.FontColor="#C9A227FF" Text="@Title" />
                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="44" SuggestedHeight="40"
                              HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="14" Brush="ButtonBrush1"
                              Command.Click="ExecuteClose" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="24" Text="X" />
                  </Children>
                </ButtonWidget>
              </Children>
            </Widget>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="12" VerticalAlignment="Top"
                    MarginTop="82" MarginLeft="22" MarginRight="22" Sprite="GradientDivider_9" Color="#FFFFFF59" />

            <!-- 信息 -->
            <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="510" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Top"
                        MarginLeft="26" MarginTop="94" Brush="MapTextBrushGal" Brush.FontSize="18" Brush.FontColor="#E8C33AFF" Text="@Info" />
            <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="510" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Top"
                        MarginLeft="26" MarginTop="128" Brush="MapTextBrushGal" Brush.FontSize="14" Brush.FontColor="#7A7060FF"
                        Text="点[出军团] 让该部队离开联军恢复独立; 首领部队需先[解散军团]。解散后各部队恢复自主行动。" />

            <!-- 表头 -->
            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Top"
                        MarginLeft="30" MarginTop="174" Brush="MapTextBrushGal" Brush.FontSize="16" Brush.FontColor="#8A8070FF" Text="部队" />
            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Top"
                        MarginLeft="210" MarginTop="174" Brush="MapTextBrushGal" Brush.FontSize="16" Brush.FontColor="#8A8070FF" Text="兵力" />
            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Top"
                        MarginLeft="300" MarginTop="174" Brush="MapTextBrushGal" Brush.FontSize="16" Brush.FontColor="#8A8070FF" Text="领袖" />
            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Top"
                        MarginLeft="430" MarginTop="174" Brush="MapTextBrushGal" Brush.FontSize="16" Brush.FontColor="#8A8070FF" Text="操作" />

            <!-- 成员列表 -->
            <TextWidget IsVisible="@EmptyVisible" WidthSizePolicy="Fixed" SuggestedWidth="510" HeightSizePolicy="CoverChildren"
                        HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="30" MarginTop="220"
                        Brush="MapTextBrushGal" Brush.FontSize="18" Brush.FontColor="#8A8070FF"
                        Text="该军团暂无成员部队" />
            <ListPanel DataSource="{Rows}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                       HorizontalAlignment="Left" VerticalAlignment="Top" MarginTop="200" MarginLeft="14" MarginRight="14"
                       StackLayout.LayoutMethod="VerticalTopToBottom">
              <ItemTemplate>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="42"
                        Sprite="ArmyManagement\voter_tuple" Color="#FFFFFFE6">
                  <Children>
                    <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="170" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                MarginLeft="16" Brush="MapTextBrushGal" Brush.FontSize="17" Brush.FontColor="#E8DCC0FF" Text="@Name" />
                    <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="76" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                MarginLeft="196" Brush="MapTextBrushGal" Brush.FontSize="17" Brush.FontColor="#F0E4C8FF" Text="@Men" />
                    <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="130" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                MarginLeft="286" Brush="MapTextBrushGal" Brush.FontSize="15" Brush.FontColor="#8A8070FF" Text="@Leader" />
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="96" SuggestedHeight="34"
                            HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="416" Sprite="ButtonBrush2">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="16" Brush.FontColor="#E8C33AFF" Text="出军团" />
                      </Children>
                    </Widget>
                  </Children>
                </Widget>
              </ItemTemplate>
            </ListPanel>

            <!-- 底部按钮 -->
            <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                          SuggestedWidth="122" SuggestedHeight="42" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                          MarginLeft="26" MarginBottom="26" Brush="ButtonBrush2" Command.Click="ExecuteClose" UpdateChildrenStates="true">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="20" Text="关闭" />
              </Children>
            </ButtonWidget>
            <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                          SuggestedWidth="150" SuggestedHeight="42" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                          MarginLeft="160" MarginBottom="26" Brush="ButtonBrush2" UpdateChildrenStates="true">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="20" Brush.FontColor="#C96A5AFF" Text="解散军团" />
              </Children>
            </ButtonWidget>

          </Children>
        </BrushWidget>

      </Children>
    </Widget>
  </Window>
</Prefab>
