<Prefab>
  <Constants>
  </Constants>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

        <!-- ===== 外交面板(左侧; 原版雕花边框, 必须用 BrushWidget 才会渲染笔刷) ===== -->
        <BrushWidget WidthSizePolicy="Fixed" SuggestedWidth="540" HeightSizePolicy="StretchToParent"
                HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="@PanelOffset" Brush="ArmyManagement.Panel.Left">
          <Children>

            <!-- 标题栏 -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="64" VerticalAlignment="Top"
                    MarginTop="14" MarginLeft="14" MarginRight="14" Sprite="BlankWhiteSquare" Color="#00000055">
              <Children>
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                            MarginLeft="18" Brush="MapTextBrushGal" Brush.FontSize="28" Color="#C9A227FF" Text="@Title" />
                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="44" SuggestedHeight="38"
                              HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="14" Brush="ButtonBrush1"
                              Command.Click="ExecuteClose" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="22" Text="X" />
                  </Children>
                </ButtonWidget>
              </Children>
            </Widget>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="12" VerticalAlignment="Top"
                    MarginTop="84" MarginLeft="22" MarginRight="22" Sprite="GradientDivider_9" Color="#FFFFFF59" />

            <!-- 提示 -->
            <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="488" HeightSizePolicy="CoverChildren"
                        HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="24" MarginTop="96"
                        Brush="MapTextBrushGal" Brush.FontSize="16" Color="#C8B98FFF" Text="@Hint" />

            <!-- 页签 -->
            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                       HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="24" MarginTop="140"
                       StackLayout.LayoutMethod="HorizontalLeftToRight">
              <Children>
                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="122" SuggestedHeight="42"
                              Brush="ButtonBrush2" Command.Click="ExecuteTabWars" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="20" Text="战争" />
                  </Children>
                </ButtonWidget>
                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="122" SuggestedHeight="42"
                              MarginLeft="18" Brush="ButtonBrush2" Command.Click="ExecuteTabAllies" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="20" Text="同盟" />
                  </Children>
                </ButtonWidget>
                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="122" SuggestedHeight="42"
                              MarginLeft="18" Brush="ButtonBrush2" Command.Click="ExecuteTabRelations" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="20" Text="关系" />
                  </Children>
                </ButtonWidget>
              </Children>
            </ListPanel>

            <!-- 选中王国详情 -->
            <Widget IsVisible="@HasSelection" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="118"
                    HorizontalAlignment="Left" VerticalAlignment="Top" MarginTop="196" MarginLeft="14" MarginRight="14"
                    Sprite="BlankWhiteSquare" Color="#00000077">
              <Children>
                <Widget WidthSizePolicy="Fixed" SuggestedWidth="3" HeightSizePolicy="StretchToParent"
                        HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="0" Sprite="BlankWhiteSquare" Color="#C9A22799" />
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                            HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="18" MarginTop="12"
                            Brush="MapTextBrushGal" Brush.FontSize="24" Color="#C9A227FF" Text="@SelName" />
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                            HorizontalAlignment="Right" VerticalAlignment="Top" MarginRight="18" MarginTop="14"
                            Brush="MapTextBrushGal" Brush.FontSize="20" Color="@SelRelationColor" Text="@SelRelation" />
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                            HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="18" MarginTop="50"
                            Brush="MapTextBrushGal" Brush.FontSize="18" Color="#C8B98FFF" Text="@SelRuler" />
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                            HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="18" MarginTop="78"
                            Brush="MapTextBrushGal" Brush.FontSize="18" Color="#F0E4C8FF" Text="@SelStance" />
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                            HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="18" MarginTop="102"
                            Brush="MapTextBrushGal" Brush.FontSize="17" Color="#C8B98FFF" Text="@SelDetail" />
              </Children>
            </Widget>

            <!-- 国家列表(可滚动) -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    MarginTop="322" MarginBottom="92" MarginLeft="14" MarginRight="14">
              <Children>
                <ScrollablePanel Id="DipScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                 AutoHideScrollBars="true" ClipRect="DipClip" InnerPanel="DipClip\DipList" VerticalScrollbar="..\DipBar">
                  <Children>
                    <Widget Id="DipClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                      <Children>
                        <ListPanel Id="DipList" DataSource="{Rows}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" StackLayout.LayoutMethod="VerticalTopToBottom">
                          <ItemTemplate>
                            <!-- 行: 原版 voter_tuple 行底 -->
                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="56"
                                    Sprite="ArmyManagement\voter_tuple" Color="#FFFFFFE6">
                              <Children>
                                <Widget WidthSizePolicy="Fixed" SuggestedWidth="3" HeightSizePolicy="StretchToParent"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="2" Sprite="BlankWhiteSquare" Color="@AccentColor" />

                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="14" Brush="ButtonBrush2"
                                              Command.Click="ExecuteSelect" UpdateChildrenStates="true">
                                  <Children>
                                    <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="10" MarginRight="10"
                                               StackLayout.LayoutMethod="HorizontalLeftToRight">
                                      <Children>
                                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center"
                                                    Brush="MapTextBrushGal" Brush.FontSize="20" Color="#F0E4C8FF" Text="@Name" />
                                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center"
                                                    MarginLeft="16" Brush="MapTextBrushGal" Brush.FontSize="20" Color="@RelationColor" Text="@RelationText" />
                                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center"
                                                    MarginLeft="16" Brush="MapTextBrushGal" Brush.FontSize="18" Color="@StanceColor" Text="@StanceText" />
                                      </Children>
                                    </ListPanel>
                                  </Children>
                                </ButtonWidget>

                                <ButtonWidget IsVisible="@CanMakePeace" DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                              SuggestedWidth="92" SuggestedHeight="40" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              MarginRight="154" Brush="ButtonBrush2" Command.Click="ExecutePeace" UpdateChildrenStates="true">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="18" Text="求和" />
                                  </Children>
                                </ButtonWidget>
                                <ButtonWidget IsVisible="@CanDeclareWar" DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                              SuggestedWidth="92" SuggestedHeight="40" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              MarginRight="154" Brush="ButtonBrush2" Command.Click="ExecuteWar" UpdateChildrenStates="true">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="18" Text="宣战" />
                                  </Children>
                                </ButtonWidget>
                                <ButtonWidget IsVisible="@CanAlly" DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                              SuggestedWidth="118" SuggestedHeight="40" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              MarginRight="24" Brush="ButtonBrush2" Command.Click="ExecuteAlly" UpdateChildrenStates="true">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="18" Text="缔结同盟" />
                                  </Children>
                                </ButtonWidget>
                                <ButtonWidget IsVisible="@CanBreakAlly" DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                              SuggestedWidth="118" SuggestedHeight="40" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              MarginRight="24" Brush="ButtonBrush2" Command.Click="ExecuteBreakAlly" UpdateChildrenStates="true">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="18" Text="解除同盟" />
                                  </Children>
                                </ButtonWidget>
                              </Children>
                            </Widget>
                          </ItemTemplate>
                        </ListPanel>
                      </Children>
                    </Widget>
                  </Children>
                </ScrollablePanel>
                <ScrollbarWidget Id="DipBar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="8"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="10" MarginBottom="10" MarginRight="2"
                                 AlignmentAxis="Vertical" Handle="DipBarHandle" MaxValue="100" MinValue="0">
                  <Children>
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2" HorizontalAlignment="Center"
                            Sprite="BlankWhiteSquare" Color="#5A4033FF" AlphaFactor="0.3" />
                    <ImageWidget Id="DipBarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedHeight="10" SuggestedWidth="6"
                                 HorizontalAlignment="Center" Brush="FaceGen.Scrollbar.Handle" Brush.AlphaFactor="0.7" />
                  </Children>
                </ScrollbarWidget>
              </Children>
            </Widget>

            <!-- 底部 -->
            <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                          SuggestedWidth="122" SuggestedHeight="42" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                          MarginLeft="24" MarginBottom="24" Brush="ButtonBrush2" Command.Click="ExecuteClose" UpdateChildrenStates="true">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="20" Text="关闭" />
              </Children>
            </ButtonWidget>

          </Children>
        </BrushWidget>

      </Children>
    </Widget>
  </Window>
</Prefab>
