<Prefab>
  <Constants>
  </Constants>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

        <!-- ===== 左侧抽屉面板(原版雕花边框, 必须用 BrushWidget 才会渲染笔刷) ===== -->
        <BrushWidget WidthSizePolicy="Fixed" SuggestedWidth="560" HeightSizePolicy="StretchToParent"
                HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="@PanelOffset" Brush="ArmyManagement.Panel.Left">
          <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="fia_ui_frame" />


            <!-- 标题栏 -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="62" VerticalAlignment="Top"
                    MarginTop="14" MarginLeft="14" MarginRight="14" Sprite="fia_ui_banner_red">
              <Children>
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                            MarginLeft="18" Brush="MapTextBrushGal" Brush.FontSize="27" Brush.FontColor="#E9CD74FF" Text="@Title" />
                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="44" SuggestedHeight="38"
                              HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="14" Brush="Fia.Button"
                              Command.Click="ExecuteClose" UpdateChildrenStates="true">
                  <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="fia_ui_button" />
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="22" Text="X" />
                  </Children>
                </ButtonWidget>
              </Children>
            </Widget>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="12" VerticalAlignment="Top"
                    MarginTop="82" MarginLeft="22" MarginRight="22" Sprite="fia_ui_divider" />

            <!-- 副标题(态B) -->
            <TextWidget IsVisible="@IsBuildMode" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                        HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="26" MarginTop="94"
                        Brush="MapTextBrushGal" Brush.FontSize="19" Brush.FontColor="#D8C9A0FF" Text="@Subtitle" />

            <!-- v4.100: 军事信息(驻守/守备营/附近我军) -->
            <TextWidget IsVisible="@IsBuildMode" WidthSizePolicy="Fixed" SuggestedWidth="520" HeightSizePolicy="CoverChildren"
                        HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="26" MarginTop="118"
                        Brush="MapTextBrushGal" Brush.FontSize="17" Brush.FontColor="#E8C33AFF" Text="@MilText" />

            <!-- 列表提示(原搜索框: 层收不到键盘输入, 已换成非输入控件) -->
            <Widget IsVisible="@IsBuildMode" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="486" SuggestedHeight="36"
                    HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="26" MarginTop="150" Sprite="BlankWhiteSquare" Color="#00000066">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="10" MarginRight="10"
                            VerticalAlignment="Center" Brush="MapTextBrushGal" Brush.FontSize="16" Brush.FontColor="#8A8070FF"
                            Text="建筑列表 · 鼠标滚轮上下翻看" />
              </Children>
            </Widget>

            <!-- v4.100: 组建军团(联军)信息 -->
            <TextWidget IsVisible="@IsBuildMode" WidthSizePolicy="Fixed" SuggestedWidth="520" HeightSizePolicy="CoverChildren"
                        HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="26" MarginTop="192"
                        Brush="MapTextBrushGal" Brush.FontSize="15" Brush.FontColor="#6AB0FFFF" Text="@ArmyText" />

            <!-- ===== 态A: 定居点树(可滚动) ===== -->
            <Widget IsVisible="@IsTreeMode" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    MarginTop="92" MarginBottom="26" MarginLeft="14" MarginRight="14">
              <Children>
                <ScrollablePanel Id="TreeScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                 AutoHideScrollBars="true" ClipRect="TreeClip" InnerPanel="TreeClip\TreeList" VerticalScrollbar="..\TreeBar">
                  <Children>
                    <Widget Id="TreeClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                      <Children>
                        <ListPanel Id="TreeList" DataSource="{Nodes}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" StackLayout.LayoutMethod="VerticalTopToBottom">
                          <ItemTemplate>
                            <Widget IsVisible="@IsVisible" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="52"
                                    Sprite="fia_ui_row" Color="#FFFFFFE6">
                              <Children>
                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="30" SuggestedHeight="34"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="@Indent" Brush="Fia.Button"
                                              Command.Click="ExecuteToggle" UpdateChildrenStates="true">
                                  <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="fia_ui_button" />
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="18" Text="@Glyph" />
                                  </Children>
                                </ButtonWidget>
                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="450" SuggestedHeight="42"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="@IndentName" Brush="Fia.Button"
                                              Command.Click="ExecuteSelect" UpdateChildrenStates="true">
                                  <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="fia_ui_button" />
                                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="10" MarginRight="10"
                                               StackLayout.LayoutMethod="HorizontalLeftToRight">
                                      <Children>
                                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="30" SuggestedHeight="30"
                                                VerticalAlignment="Center" Sprite="@Sprite" />
                                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center"
                                                    MarginLeft="10" Brush="MapTextBrushGal" Brush.FontSize="21" Brush.FontColor="#F0E4C8FF" Text="@Name" />
                                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center"
                                                    MarginLeft="16" Brush="MapTextBrushGal" Brush.FontSize="18" Brush.FontColor="#D8C9A0FF" Text="@Slots" />
                                      </Children>
                                    </ListPanel>
                                  </Children>
                                </ButtonWidget>
                              </Children>
                            </Widget>
                          </ItemTemplate>
                        </ListPanel>
                      </Children>
                    </Widget>
                  </Children>
                </ScrollablePanel>
                <ScrollbarWidget Id="TreeBar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="8"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="10" MarginBottom="10" MarginRight="2"
                                 AlignmentAxis="Vertical" Handle="TreeBarHandle" MaxValue="100" MinValue="0">
                  <Children>
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2" HorizontalAlignment="Center"
                            Sprite="BlankWhiteSquare" Color="#5A4033FF" AlphaFactor="0.3" />
                    <ImageWidget Id="TreeBarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedHeight="10" SuggestedWidth="6"
                                 HorizontalAlignment="Center" Brush="FaceGen.Scrollbar.Handle" Brush.AlphaFactor="0.7" />
                  </Children>
                </ScrollbarWidget>
              </Children>
            </Widget>

            <!-- ===== 态B: 建筑列表(可滚动) =====
                 v4.282: MarginBottom 92 -> 258 —— 底部让出"驻扎的海军"区块(258 = 76 + 174 + 8)。
                 这个数字与 SettlementDrawerVM.NavyReserve / UI\SettlementDrawer.cs 的行热区守卫**同源**,
                 改一处必须改三处(VM 常量 / 本文件 / 热区监听)。 -->
            <Widget IsVisible="@IsBuildMode" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    MarginTop="224" MarginBottom="258" MarginLeft="14" MarginRight="14">
              <Children>
                <ScrollablePanel Id="RowsScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                 AutoHideScrollBars="true" ClipRect="RowsClip" InnerPanel="RowsClip\RowsList" VerticalScrollbar="..\RowsBar">
                  <Children>
                    <Widget Id="RowsClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                      <Children>
                        <ListPanel Id="RowsList" DataSource="{Rows}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" StackLayout.LayoutMethod="VerticalTopToBottom">
                          <ItemTemplate>
                            <Widget IsVisible="@IsVisible" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="54"
                                    Sprite="fia_ui_row" Color="#FFFFFFE6">
                              <Children>
                                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="16"
                                           StackLayout.LayoutMethod="HorizontalLeftToRight">
                                  <Children>
                                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="34"
                                            VerticalAlignment="Center" Sprite="@Icon" Color="@IconColor" />
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center"
                                                MarginLeft="10" Brush="MapTextBrushGal" Brush.FontSize="21" Brush.FontColor="#F0E4C8FF" Text="@Name" />
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center"
                                                MarginLeft="12" Brush="MapTextBrushGal" Brush.FontSize="19" Brush.FontColor="#D8C9A0FF" Text="@CountText" />
                                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="24" SuggestedHeight="24"
                                            VerticalAlignment="Center" MarginLeft="14" Sprite="@ModeSprite" />
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center"
                                                MarginLeft="4" Brush="MapTextBrushGal" Brush.FontSize="18" Brush.FontColor="#D8C9A0FF" Text="@ModeText" />
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center"
                                                MarginLeft="14" Brush="MapTextBrushGal" Brush.FontSize="19" Brush.FontColor="@StatusColor" Text="@Status" />
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center"
                                                MarginLeft="12" Brush="MapTextBrushGal" Brush.FontSize="16" Brush.FontColor="@StateColor" Text="@StateText" />
                                  </Children>
                                </ListPanel>
                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="32"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="74" Brush="Fia.Button"
                                              Command.Click="ExecuteRemove" UpdateChildrenStates="true">
                                  <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="fia_ui_button" />
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="20" Text="-" />
                                  </Children>
                                </ButtonWidget>
                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="32"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="16" Brush="Fia.Button"
                                              Command.Click="ExecuteAdd" UpdateChildrenStates="true">
                                  <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="fia_ui_button" />
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="20" Text="+" />
                                  </Children>
                                </ButtonWidget>
                              </Children>
                            </Widget>
                          </ItemTemplate>
                        </ListPanel>
                      </Children>
                    </Widget>
                  </Children>
                </ScrollablePanel>
                <ScrollbarWidget Id="RowsBar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="8"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="10" MarginBottom="10" MarginRight="2"
                                 AlignmentAxis="Vertical" Handle="RowsBarHandle" MaxValue="100" MinValue="0">
                  <Children>
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2" HorizontalAlignment="Center"
                            Sprite="BlankWhiteSquare" Color="#5A4033FF" AlphaFactor="0.3" />
                    <ImageWidget Id="RowsBarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedHeight="10" SuggestedWidth="6"
                                 HorizontalAlignment="Center" Brush="FaceGen.Scrollbar.Handle" Brush.AlphaFactor="0.7" />
                  </Children>
                </ScrollbarWidget>
              </Children>
            </Widget>

            <!-- ================= v4.282: 驻扎的海军(底锚定区块, 只在态B显示) =================
                 用户要求: "城市详情页扩充, 海军可以驻扎在城市内(仅沿海城市)"。
                 版面(面板宽 560; 底栏按钮占 sh-68..sh-26, 故区块底边 = 底距 76):
                   标题行      MarginBottom=230 h20  —— "驻扎的海军(N 支)"
                   港口信息行  MarginBottom=210 h18  —— 沿海/船坞等级/可造与未解锁(内陆城镇如实说明)
                   舰队行 i    MarginBottom=164/120/76 h40(行距 4, 最多 3 行)
                     行内: 图标 x12 / 名称 x46 / 数值 x46(第二行) / [查看] MarginLeft=366 / [召回] MarginLeft=438
                 热区(UI\SettlementDrawer.cs 的 RegisterSpots, 改一处必须改两处):
                   [查看] = 面板 380, sh-203+i*44, 64, 30      → _vm.NavyActionByKey(key, 0)
                   [召回] = 面板 452, sh-203+i*44, 64, 30      → _vm.NavyActionByKey(key, 1)
                   (行顶 = sh-208 + i*44; 行内按钮垂直居中 h30 -> 顶边 = 行顶 + 5 = sh-203 + i*44)
                   ★ 行内按钮用 MarginLeft 左锚定(容器左缩进 14): 本页既有的右锚定 ± 按钮与热区
                     推算本身就差约 10 像素, 左锚定没有这个不确定性。
                 ★ 渲染复用本页既有行风格: 同一张 fia_ui_row 底图 + ListPanel + 同名笔刷/字号。 -->
            <TextWidget IsVisible="@IsBuildMode" WidthSizePolicy="Fixed" SuggestedWidth="240" HeightSizePolicy="Fixed" SuggestedHeight="20"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" MarginLeft="26" MarginBottom="230"
                        Brush="MapTextBrushGal" Brush.FontSize="17" Brush.FontColor="#E9CD74FF" Text="@NavyTitle" />
            <TextWidget IsVisible="@IsBuildMode" WidthSizePolicy="Fixed" SuggestedWidth="520" HeightSizePolicy="Fixed" SuggestedHeight="18" ClipContents="true"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" MarginLeft="26" MarginBottom="210"
                        Brush="MapTextBrushGal" Brush.FontSize="14" Brush.FontColor="#8FD8E8FF" Text="@NavyInfo" />
            <ListPanel IsVisible="@ShowNavy" DataSource="{NavyRows}" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="132"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom" MarginLeft="14" MarginRight="14" MarginBottom="76"
                       StackLayout.LayoutMethod="VerticalTopToBottom">
              <ItemTemplate>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40" MarginBottom="4" Sprite="fia_ui_row">
                  <Children>
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="26" SuggestedHeight="26"
                            HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="12" Sprite="@Icon" />
                    <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="170" HeightSizePolicy="Fixed" SuggestedHeight="20" ClipContents="true"
                                HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="46" MarginTop="1"
                                Brush="MapTextBrushGal" Brush.FontSize="17" Brush.FontColor="#F0E4C8FF" Text="@Name" />
                    <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="310" HeightSizePolicy="Fixed" SuggestedHeight="18" ClipContents="true"
                                HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="46" MarginTop="21"
                                Brush="MapTextBrushGal" Brush.FontSize="14" Brush.FontColor="@NumsColor" Text="@Nums" />
                    <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="330" HeightSizePolicy="Fixed" SuggestedHeight="18" ClipContents="true"
                                HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="192" MarginTop="21"
                                Brush="MapTextBrushGal" Brush.FontSize="13" Brush.FontColor="@NoteColor" Text="@Note" />
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="64" SuggestedHeight="30"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="366" Brush="Fia.Button" UpdateChildrenStates="true">
                      <Children>
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="fia_ui_button" />
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="16" Brush.FontColor="#E9CD74FF" Text="查看" />
                      </Children>
                    </ButtonWidget>
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="64" SuggestedHeight="30"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="438" Brush="Fia.Button" UpdateChildrenStates="true">
                      <Children>
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="fia_ui_button" />
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="16" Brush.FontColor="#C96A5AFF" Text="召回" />
                      </Children>
                    </ButtonWidget>
                  </Children>
                </Widget>
              </ItemTemplate>
            </ListPanel>

            <!-- 底栏(态B): 返回树 -->
            <ButtonWidget IsVisible="@IsBuildMode" DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                          SuggestedWidth="124" SuggestedHeight="42" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                          MarginLeft="26" MarginBottom="26" Brush="Fia.Button" Command.Click="ExecuteBack" UpdateChildrenStates="true">
              <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="fia_ui_button" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="20" Text="返回树" />
              </Children>
            </ButtonWidget>

            <!-- v4.100: 一键唤出(守备营编成野战军团 / 召唤最近联军) -->
            <ButtonWidget IsVisible="@IsBuildMode" DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                          SuggestedWidth="150" SuggestedHeight="42" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                          MarginLeft="160" MarginBottom="26" Brush="Fia.Button" UpdateChildrenStates="true">
              <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="fia_ui_button" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="20" Brush.FontColor="#7FBF6AFF" Text="唤出军团" />
              </Children>
            </ButtonWidget>

          </Children>
        </BrushWidget>

      </Children>
    </Widget>
  </Window>
</Prefab>
