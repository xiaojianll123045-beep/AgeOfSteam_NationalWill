<Prefab>
  <Constants>
  </Constants>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

        <!-- ===== 左侧抽屉面板(原版雕花边框, 必须用 BrushWidget 才会渲染笔刷) ===== -->
        <BrushWidget WidthSizePolicy="Fixed" SuggestedWidth="560" HeightSizePolicy="StretchToParent"
                HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="@PanelOffset" Brush="ArmyManagement.Panel.Left">
          <Children>

            <!-- 标题栏 -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="62" VerticalAlignment="Top"
                    MarginTop="14" MarginLeft="14" MarginRight="14" Sprite="BlankWhiteSquare" Color="#00000055">
              <Children>
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                            MarginLeft="18" Brush="MapTextBrushGal" Brush.FontSize="27" Color="#C9A227FF" Text="@Title" />
                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="44" SuggestedHeight="38"
                              HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="14" Brush="ButtonBrush1"
                              Command.Click="ExecuteClose" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="22" Text="X" />
                  </Children>
                </ButtonWidget>
              </Children>
            </Widget>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="12" VerticalAlignment="Top"
                    MarginTop="82" MarginLeft="22" MarginRight="22" Sprite="GradientDivider_9" Color="#FFFFFF59" />

            <!-- 副标题(态B) -->
            <TextWidget IsVisible="@IsBuildMode" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                        HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="26" MarginTop="94"
                        Brush="MapTextBrushGal" Brush.FontSize="19" Color="#C8B98FFF" Text="@Subtitle" />

            <!-- 搜索框(态B) -->
            <Widget IsVisible="@IsBuildMode" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="486" SuggestedHeight="36"
                    HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="26" MarginTop="124" Sprite="BlankWhiteSquare" Color="#00000066">
              <Children>
                <EditableTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="10" MarginRight="10"
                                    Text="@SearchText" Brush="MapTextBrushGal" />
              </Children>
            </Widget>

            <!-- ===== 态A: 定居点树(可滚动) ===== -->
            <Widget IsVisible="@IsTreeMode" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    MarginTop="92" MarginBottom="26" MarginLeft="14" MarginRight="14">
              <Children>
                <ScrollablePanel Id="TreeScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                 AutoHideScrollBars="true" ClipRect="TreeClip" InnerPanel="TreeClip\TreeList" VerticalScrollbar="..\TreeBar">
                  <Children>
                    <Widget Id="TreeClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                      <Children>
                        <ListPanel Id="TreeList" DataSource="{Nodes}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" StackLayout.LayoutMethod="VerticalTopToBottom">
                          <ItemTemplate>
                            <Widget IsVisible="@IsVisible" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="52"
                                    Sprite="ArmyManagement\voter_tuple" Color="#FFFFFFE6">
                              <Children>
                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="30" SuggestedHeight="34"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="@Indent" Brush="ButtonBrush1"
                                              Command.Click="ExecuteToggle" UpdateChildrenStates="true">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="18" Text="@Glyph" />
                                  </Children>
                                </ButtonWidget>
                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="450" SuggestedHeight="42"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="@IndentName" Brush="ButtonBrush2"
                                              Command.Click="ExecuteSelect" UpdateChildrenStates="true">
                                  <Children>
                                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="10" MarginRight="10"
                                               StackLayout.LayoutMethod="HorizontalLeftToRight">
                                      <Children>
                                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="30" SuggestedHeight="30"
                                                VerticalAlignment="Center" Sprite="@Sprite" />
                                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center"
                                                    MarginLeft="10" Brush="MapTextBrushGal" Brush.FontSize="21" Color="#F0E4C8FF" Text="@Name" />
                                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center"
                                                    MarginLeft="16" Brush="MapTextBrushGal" Brush.FontSize="18" Color="#C8B98FFF" Text="@Slots" />
                                      </Children>
                                    </ListPanel>
                                  </Children>
                                </ButtonWidget>
                              </Children>
                            </Widget>
                          </ItemTemplate>
                        </ListPanel>
                      </Children>
                    </Widget>
                  </Children>
                </ScrollablePanel>
                <ScrollbarWidget Id="TreeBar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="8"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="10" MarginBottom="10" MarginRight="2"
                                 AlignmentAxis="Vertical" Handle="TreeBarHandle" MaxValue="100" MinValue="0">
                  <Children>
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2" HorizontalAlignment="Center"
                            Sprite="BlankWhiteSquare" Color="#5A4033FF" AlphaFactor="0.3" />
                    <ImageWidget Id="TreeBarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedHeight="10" SuggestedWidth="6"
                                 HorizontalAlignment="Center" Brush="FaceGen.Scrollbar.Handle" Brush.AlphaFactor="0.7" />
                  </Children>
                </ScrollbarWidget>
              </Children>
            </Widget>

            <!-- ===== 态B: 建筑列表(可滚动) ===== -->
            <Widget IsVisible="@IsBuildMode" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    MarginTop="174" MarginBottom="92" MarginLeft="14" MarginRight="14">
              <Children>
                <ScrollablePanel Id="RowsScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                 AutoHideScrollBars="true" ClipRect="RowsClip" InnerPanel="RowsClip\RowsList" VerticalScrollbar="..\RowsBar">
                  <Children>
                    <Widget Id="RowsClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                      <Children>
                        <ListPanel Id="RowsList" DataSource="{Rows}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" StackLayout.LayoutMethod="VerticalTopToBottom">
                          <ItemTemplate>
                            <Widget IsVisible="@IsVisible" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="54"
                                    Sprite="ArmyManagement\voter_tuple" Color="#FFFFFFE6">
                              <Children>
                                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="16"
                                           StackLayout.LayoutMethod="HorizontalLeftToRight">
                                  <Children>
                                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="34"
                                            VerticalAlignment="Center" Sprite="@Icon" Color="@IconColor" />
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center"
                                                MarginLeft="10" Brush="MapTextBrushGal" Brush.FontSize="21" Color="#F0E4C8FF" Text="@Name" />
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center"
                                                MarginLeft="12" Brush="MapTextBrushGal" Brush.FontSize="19" Color="#C8B98FFF" Text="@CountText" />
                                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="24" SuggestedHeight="24"
                                            VerticalAlignment="Center" MarginLeft="14" Sprite="@ModeSprite" />
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center"
                                                MarginLeft="4" Brush="MapTextBrushGal" Brush.FontSize="18" Color="#C8B98FFF" Text="@ModeText" />
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center"
                                                MarginLeft="14" Brush="MapTextBrushGal" Brush.FontSize="19" Color="@StatusColor" Text="@Status" />
                                  </Children>
                                </ListPanel>
                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="32"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="74" Brush="ButtonBrush1"
                                              Command.Click="ExecuteRemove" UpdateChildrenStates="true">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="20" Text="-" />
                                  </Children>
                                </ButtonWidget>
                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="32"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="16" Brush="ButtonBrush1"
                                              Command.Click="ExecuteAdd" UpdateChildrenStates="true">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="20" Text="+" />
                                  </Children>
                                </ButtonWidget>
                              </Children>
                            </Widget>
                          </ItemTemplate>
                        </ListPanel>
                      </Children>
                    </Widget>
                  </Children>
                </ScrollablePanel>
                <ScrollbarWidget Id="RowsBar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="8"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="10" MarginBottom="10" MarginRight="2"
                                 AlignmentAxis="Vertical" Handle="RowsBarHandle" MaxValue="100" MinValue="0">
                  <Children>
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2" HorizontalAlignment="Center"
                            Sprite="BlankWhiteSquare" Color="#5A4033FF" AlphaFactor="0.3" />
                    <ImageWidget Id="RowsBarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedHeight="10" SuggestedWidth="6"
                                 HorizontalAlignment="Center" Brush="FaceGen.Scrollbar.Handle" Brush.AlphaFactor="0.7" />
                  </Children>
                </ScrollbarWidget>
              </Children>
            </Widget>

            <!-- 底栏(态B): 返回树 -->
            <ButtonWidget IsVisible="@IsBuildMode" DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                          SuggestedWidth="124" SuggestedHeight="42" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                          MarginLeft="26" MarginBottom="26" Brush="ButtonBrush2" Command.Click="ExecuteBack" UpdateChildrenStates="true">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="20" Text="返回树" />
              </Children>
            </ButtonWidget>

          </Children>
        </BrushWidget>

      </Children>
    </Widget>
  </Window>
</Prefab>
