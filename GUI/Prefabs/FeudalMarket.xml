<Prefab>
  <Constants>
  </Constants>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

        <!-- ===== 市场面板(左侧, 维多利亚3 风格; 原版雕花边框) ===== -->
        <BrushWidget WidthSizePolicy="Fixed" SuggestedWidth="780" HeightSizePolicy="StretchToParent"
                HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="@PanelOffset" Brush="ArmyManagement.Panel.Left">
          <Children>

            <!-- 标题栏 -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="62" VerticalAlignment="Top"
                    MarginTop="14" MarginLeft="14" MarginRight="14" Sprite="BlankWhiteSquare" Color="#00000055">
              <Children>
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                            MarginLeft="18" Brush="MapTextBrushGal" Brush.FontSize="29" Color="#C9A227FF" Text="@Title" />
                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="96" SuggestedHeight="38"
                              HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="66" Brush="ButtonBrush2"
                              Command.Click="ExecuteToggleScope" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="20" Text="@ScopeText" />
                  </Children>
                </ButtonWidget>
                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="44" SuggestedHeight="38"
                              HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="14" Brush="ButtonBrush1"
                              Command.Click="ExecuteClose" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="24" Text="X" />
                  </Children>
                </ButtonWidget>
              </Children>
            </Widget>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="12" VerticalAlignment="Top"
                    MarginTop="82" MarginLeft="22" MarginRight="22" Sprite="GradientDivider_9" Color="#FFFFFF59" />

            <!-- 提示(多行图例: 解释每个数字是什么意思) -->
            <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="728" HeightSizePolicy="CoverChildren"
                        HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="26" MarginTop="92"
                        Brush="MapTextBrushGal" Brush.FontSize="16" Color="#C8B98FFF" Text="@Hint" />

            <!-- 页签 -->
            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                       HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="26" MarginTop="186"
                       StackLayout.LayoutMethod="HorizontalLeftToRight">
              <Children>
                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="130" SuggestedHeight="42"
                              Brush="ButtonBrush2" Command.Click="ExecuteTabGoods" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="22" Text="商品" />
                  </Children>
                </ButtonWidget>
                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="130" SuggestedHeight="42"
                              MarginLeft="14" Brush="ButtonBrush2" Command.Click="ExecuteTabTrade" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="22" Text="贸易" />
                  </Children>
                </ButtonWidget>
                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="150" SuggestedHeight="42"
                              MarginLeft="14" Brush="ButtonBrush2" Command.Click="ExecuteTabFood" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="22" Text="粮食安全" />
                  </Children>
                </ButtonWidget>
              </Children>
            </ListPanel>

            <!-- 商品分类(图标按钮; 原"过滤器"标题和状态框已删——空间让给字号, 筛选状态看按钮高亮) -->
            <Widget IsVisible="@IsGoodsTab" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                    HorizontalAlignment="Left" VerticalAlignment="Top" MarginTop="240">
              <Children>
                <ListPanel DataSource="{Filters}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                           HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="26" MarginTop="0"
                           StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <ItemTemplate>
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                  SuggestedWidth="76" SuggestedHeight="52" MarginRight="10" Brush="ButtonBrush2"
                                  Command.Click="ExecuteSelect" UpdateChildrenStates="true">
                      <Children>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="26" SuggestedHeight="26"
                                HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="4" Sprite="@Sprite" Color="@Color" />
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                    MarginBottom="2" Brush="MapTextBrushGal" Brush.FontSize="16" Color="@Color" Text="@Label" />
                      </Children>
                    </ButtonWidget>
                  </ItemTemplate>
                </ListPanel>
              </Children>
            </Widget>

            <!-- ===== 商品表 ===== -->
            <Widget IsVisible="@IsGoodsTab" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    MarginTop="320" MarginBottom="82" MarginLeft="14" MarginRight="14">
              <Children>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="28" VerticalAlignment="Top"
                        Sprite="BlankWhiteSquare" Color="#00000055">
                  <Children>
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="18" SuggestedHeight="18"
                            HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="58" Sprite="Inventory\icon_gold" />
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                MarginLeft="84" Brush="MapTextBrushGal" Brush.FontSize="18" Color="#C9A227FF" Text="市场价" />
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                MarginLeft="366" Brush="MapTextBrushGal" Brush.FontSize="18" Color="#C9A227FF" Text="比昨天" />
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                MarginLeft="436" Brush="MapTextBrushGal" Brush.FontSize="18" Color="#C9A227FF" Text="产出" />
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                MarginLeft="512" Brush="MapTextBrushGal" Brush.FontSize="18" Color="#C9A227FF" Text="消耗" />
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                MarginLeft="576" Brush="MapTextBrushGal" Brush.FontSize="18" Color="#C9A227FF" Text="现存" />
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                MarginLeft="640" Brush="MapTextBrushGal" Brush.FontSize="18" Color="#C9A227FF" Text="缺口" />
                  </Children>
                </Widget>

                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="30">
                  <Children>
                    <ScrollablePanel Id="MktScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                     AutoHideScrollBars="true" ClipRect="MktClip" InnerPanel="MktClip\MktList" VerticalScrollbar="..\MktBar">
                      <Children>
                        <Widget Id="MktClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                          <Children>
                            <ListPanel Id="MktList" DataSource="{Rows}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <ItemTemplate>
                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="48"
                                        Sprite="ArmyManagement\voter_tuple" Color="#FFFFFFE6">
                                  <Children>
                                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="34"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="16" Sprite="@Icon" />
                                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="20" SuggestedHeight="20"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="58" Sprite="Inventory\icon_gold" />
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                MarginLeft="84" Brush="MapTextBrushGal" Brush.FontSize="22" Color="#C9A227FF" Text="@PriceText" />

                                    <!-- 价格条: 底 + 填充 + 基础价刻度 -->
                                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="200" SuggestedHeight="16"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="150" Sprite="BlankWhiteSquare" Color="#00000088" />
                                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="@PriceBarWidth" SuggestedHeight="16"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="150" Sprite="BlankWhiteSquare" Color="@PriceBarColor" />
                                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="2" SuggestedHeight="20"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="250" Sprite="BlankWhiteSquare" Color="#C9A227AA" />

                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                MarginLeft="366" Brush="MapTextBrushGal" Brush.FontSize="20" Color="@ChangeColor" Text="@ChangeText" />
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                MarginLeft="436" Brush="MapTextBrushGal" Brush.FontSize="20" Color="#C8B98FFF" Text="@SupplyText" />
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                MarginLeft="512" Brush="MapTextBrushGal" Brush.FontSize="20" Color="#C8B98FFF" Text="@DemandText" />
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                MarginLeft="576" Brush="MapTextBrushGal" Brush.FontSize="20" Color="#F0E4C8FF" Text="@StockText" />
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                MarginLeft="640" Brush="MapTextBrushGal" Brush.FontSize="20" Color="@GapColor" Text="@GapText" />
                                  </Children>
                                </Widget>
                              </ItemTemplate>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </ScrollablePanel>
                    <ScrollbarWidget Id="MktBar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="8"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="10" MarginBottom="10" MarginRight="2"
                                     AlignmentAxis="Vertical" Handle="MktBarHandle" MaxValue="100" MinValue="0">
                      <Children>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2" HorizontalAlignment="Center"
                                Sprite="BlankWhiteSquare" Color="#5A4033FF" AlphaFactor="0.3" />
                        <ImageWidget Id="MktBarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedHeight="10" SuggestedWidth="6"
                                     HorizontalAlignment="Center" Brush="FaceGen.Scrollbar.Handle" Brush.AlphaFactor="0.7" />
                      </Children>
                    </ScrollbarWidget>
                  </Children>
                </Widget>
              </Children>
            </Widget>

            <!-- ===== 贸易表 ===== -->
            <Widget IsVisible="@IsTradeTab" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    MarginTop="176" MarginBottom="82" MarginLeft="14" MarginRight="14">
              <Children>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="28" VerticalAlignment="Top"
                        Sprite="BlankWhiteSquare" Color="#00000055">
                  <Children>
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                MarginLeft="20" Brush="MapTextBrushGal" Brush.FontSize="15" Color="#C9A227FF" Text="城市" />
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                MarginLeft="300" Brush="MapTextBrushGal" Brush.FontSize="15" Color="#C9A227FF" Text="调运容量/日" />
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                MarginLeft="460" Brush="MapTextBrushGal" Brush.FontSize="15" Color="#C9A227FF" Text="进出口容量/日" />
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                MarginLeft="620" Brush="MapTextBrushGal" Brush.FontSize="15" Color="#C9A227FF" Text="在建" />
                  </Children>
                </Widget>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="30">
                  <Children>
                    <ScrollablePanel Id="TrdScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                     AutoHideScrollBars="true" ClipRect="TrdClip" InnerPanel="TrdClip\TrdList" VerticalScrollbar="..\TrdBar">
                      <Children>
                        <Widget Id="TrdClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                          <Children>
                            <ListPanel Id="TrdList" DataSource="{TradeRows}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <ItemTemplate>
                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="48"
                                        Sprite="ArmyManagement\voter_tuple" Color="#FFFFFFE6">
                                  <Children>
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                MarginLeft="20" Brush="MapTextBrushGal" Brush.FontSize="19" Color="#F0E4C8FF" Text="@Name" />
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                MarginLeft="300" Brush="MapTextBrushGal" Brush.FontSize="18" Color="#C9A227FF" Text="@TradeCap" />
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                MarginLeft="460" Brush="MapTextBrushGal" Brush.FontSize="18" Color="#C9A227FF" Text="@ImportCap" />
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                MarginLeft="620" Brush="MapTextBrushGal" Brush.FontSize="18" Color="#C8B98FFF" Text="@QueuedText" />
                                  </Children>
                                </Widget>
                              </ItemTemplate>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </ScrollablePanel>
                    <ScrollbarWidget Id="TrdBar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="8"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="10" MarginBottom="10" MarginRight="2"
                                     AlignmentAxis="Vertical" Handle="TrdBarHandle" MaxValue="100" MinValue="0">
                      <Children>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2" HorizontalAlignment="Center"
                                Sprite="BlankWhiteSquare" Color="#5A4033FF" AlphaFactor="0.3" />
                        <ImageWidget Id="TrdBarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedHeight="10" SuggestedWidth="6"
                                     HorizontalAlignment="Center" Brush="FaceGen.Scrollbar.Handle" Brush.AlphaFactor="0.7" />
                      </Children>
                    </ScrollbarWidget>
                  </Children>
                </Widget>
              </Children>
            </Widget>

            <!-- ===== 粮食安全表 ===== -->
            <Widget IsVisible="@IsFoodTab" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    MarginTop="176" MarginBottom="82" MarginLeft="14" MarginRight="14">
              <Children>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="28" VerticalAlignment="Top"
                        Sprite="BlankWhiteSquare" Color="#00000055">
                  <Children>
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                MarginLeft="20" Brush="MapTextBrushGal" Brush.FontSize="15" Color="#C9A227FF" Text="城市" />
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                MarginLeft="300" Brush="MapTextBrushGal" Brush.FontSize="15" Color="#C9A227FF" Text="粮食库存" />
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                MarginLeft="440" Brush="MapTextBrushGal" Brush.FontSize="15" Color="#C9A227FF" Text="日消耗" />
                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                MarginLeft="580" Brush="MapTextBrushGal" Brush.FontSize="15" Color="#C9A227FF" Text="可支撑(天)" />
                  </Children>
                </Widget>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="30">
                  <Children>
                    <ScrollablePanel Id="FoodScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                     AutoHideScrollBars="true" ClipRect="FoodClip" InnerPanel="FoodClip\FoodList" VerticalScrollbar="..\FoodBar">
                      <Children>
                        <Widget Id="FoodClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                          <Children>
                            <ListPanel Id="FoodList" DataSource="{FoodRows}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <ItemTemplate>
                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="48"
                                        Sprite="ArmyManagement\voter_tuple" Color="#FFFFFFE6">
                                  <Children>
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                MarginLeft="20" Brush="MapTextBrushGal" Brush.FontSize="19" Color="#F0E4C8FF" Text="@Name" />
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                MarginLeft="300" Brush="MapTextBrushGal" Brush.FontSize="18" Color="#F0E4C8FF" Text="@StockText" />
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                MarginLeft="440" Brush="MapTextBrushGal" Brush.FontSize="18" Color="#C8B98FFF" Text="@NeedText" />
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                MarginLeft="580" Brush="MapTextBrushGal" Brush.FontSize="18" Color="@DaysColor" Text="@DaysText" />
                                  </Children>
                                </Widget>
                              </ItemTemplate>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </ScrollablePanel>
                    <ScrollbarWidget Id="FoodBar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="8"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="10" MarginBottom="10" MarginRight="2"
                                     AlignmentAxis="Vertical" Handle="FoodBarHandle" MaxValue="100" MinValue="0">
                      <Children>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2" HorizontalAlignment="Center"
                                Sprite="BlankWhiteSquare" Color="#5A4033FF" AlphaFactor="0.3" />
                        <ImageWidget Id="FoodBarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedHeight="10" SuggestedWidth="6"
                                     HorizontalAlignment="Center" Brush="FaceGen.Scrollbar.Handle" Brush.AlphaFactor="0.7" />
                      </Children>
                    </ScrollbarWidget>
                  </Children>
                </Widget>
              </Children>
            </Widget>

            <!-- 底部 -->
            <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                          SuggestedWidth="122" SuggestedHeight="42" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                          MarginLeft="26" MarginBottom="26" Brush="ButtonBrush2" Command.Click="ExecuteClose" UpdateChildrenStates="true">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="22" Text="关闭" />
              </Children>
            </ButtonWidget>

          </Children>
        </BrushWidget>

        <!-- 悬停提示(跟随鼠标): 商品名+分类 / 产地建筑+基础价 / 简介 -->
        <BrushWidget IsVisible="@TooltipVisible" WidthSizePolicy="Fixed" SuggestedWidth="320" HeightSizePolicy="CoverChildren"
                     HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="@TooltipX" MarginTop="@TooltipY"
                     Brush="ArmyManagement.Panel.Left" Brush.AlphaFactor="0.97">
          <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                    MarginLeft="18" MarginRight="18" MarginTop="14" MarginBottom="16">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Brush="MapTextBrushGal" Brush.FontSize="20" Color="#C9A227FF" Text="@TooltipName" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                            HorizontalAlignment="Left" VerticalAlignment="Top" MarginTop="28"
                            Brush="MapTextBrushGal" Brush.FontSize="16" Color="#C8B98FFF" Text="@TooltipLine2" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                            HorizontalAlignment="Left" VerticalAlignment="Top" MarginTop="52"
                            Brush="MapTextBrushGal" Brush.FontSize="17" Color="#F0E4C8FF" Text="@TooltipDesc" />
              </Children>
            </Widget>
          </Children>
        </BrushWidget>

      </Children>
    </Widget>
  </Window>
</Prefab>
