        <!-- v4.79c: 选国阶段遮挡原版时间盘 —— 风格化提示横幅(宽度按文字动态计算), 接管后自动隐藏 -->
        <!-- v4.82: 背景为普通 Widget + CanAcceptEvents="true" 参与命中测试(拦住时间盘悬停);
                  不用 ButtonWidget(会套默认按钮笔刷外观, 深色背景被盖成米色) -->
        <Widget IsVisible="@HideTimePanel" WidthSizePolicy="Fixed" SuggestedWidth="@PanelWidth" HeightSizePolicy="Fixed" SuggestedHeight="108"
                HorizontalAlignment="Center" VerticalAlignment="Bottom">
          <Children>
            <Widget CanAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
