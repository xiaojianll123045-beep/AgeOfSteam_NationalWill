        <ListPanel DataSource="{Labels}" WidthSizePolicy="Fixed" SuggestedWidth="120" HeightSizePolicy="CoverChildren"
                   HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="50" MarginTop="145"
                   StackLayout.LayoutMethod="VerticalTopToBottom">
          <ItemTemplate>
            <Widget WidthSizePolicy="Fixed" SuggestedWidth="120" HeightSizePolicy="Fixed" SuggestedHeight="54">
              <Children>
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
