<Prefab>
  <Constants>
  </Constants>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

        <!-- ===== 批量建造面板(左侧; 原版雕花边框, 必须用 BrushWidget 才会渲染笔刷) ===== -->
        <BrushWidget WidthSizePolicy="Fixed" SuggestedWidth="480" HeightSizePolicy="StretchToParent"
                HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="@PanelOffset" Brush="ArmyManagement.Panel.Left">
          <Children>

            <!-- 标题栏 -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="62" VerticalAlignment="Top"
                    MarginTop="14" MarginLeft="14" MarginRight="14" Sprite="BlankWhiteSquare" Color="#00000055">
              <Children>
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center"
                            MarginLeft="18" Brush="MapTextBrushGal" Brush.FontSize="27" Color="#C9A227FF" Text="@Title" />
                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="44" SuggestedHeight="38"
                              HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="14" Brush="ButtonBrush1"
                              Command.Click="ExecuteClose" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="22" Text="X" />
                  </Children>
                </ButtonWidget>
              </Children>
            </Widget>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="12" VerticalAlignment="Top"
                    MarginTop="82" MarginLeft="22" MarginRight="22" Sprite="GradientDivider_9" Color="#FFFFFF59" />

            <!-- 提示 -->
            <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="424" HeightSizePolicy="CoverChildren"
                        HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="26" MarginTop="96"
                        Brush="MapTextBrushGal" Brush.FontSize="16" Color="#C8B98FFF" Text="@Hint" />

            <!-- 方案统计 -->
            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                        HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="26" MarginTop="140"
                        Brush="MapTextBrushGal" Brush.FontSize="21" Color="#C9A227FF" Text="@PlanSummary" />

            <!-- ===== 方案列表(可滚动) ===== -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    MarginTop="176" MarginBottom="248" MarginLeft="14" MarginRight="14">
              <Children>
                <ScrollablePanel Id="PlanScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                 AutoHideScrollBars="true" ClipRect="PlanClip" InnerPanel="PlanClip\PlanList" VerticalScrollbar="..\PlanBar">
                  <Children>
                    <Widget Id="PlanClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                      <Children>
                        <ListPanel Id="PlanList" DataSource="{Rows}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" StackLayout.LayoutMethod="VerticalTopToBottom">
                          <ItemTemplate>
                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="54"
                                    Sprite="ArmyManagement\voter_tuple" Color="#FFFFFFE6">
                              <Children>
                                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="16"
                                           StackLayout.LayoutMethod="HorizontalLeftToRight">
                                  <Children>
                                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="34"
                                            VerticalAlignment="Center" Sprite="@Icon" />
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center"
                                                MarginLeft="10" Brush="MapTextBrushGal" Brush.FontSize="21" Color="#F0E4C8FF" Text="@Name" />
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center"
                                                MarginLeft="12" Brush="MapTextBrushGal" Brush.FontSize="18" Color="#C8B98FFF" Text="@CategoryText" />
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center"
                                                MarginLeft="12" Brush="MapTextBrushGal" Brush.FontSize="20" Color="#C9A227FF" Text="@CountText" />
                                  </Children>
                                </ListPanel>
                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="32"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="114" Brush="ButtonBrush1"
                                              Command.Click="ExecuteMinus" UpdateChildrenStates="true">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="20" Text="-" />
                                  </Children>
                                </ButtonWidget>
                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="32"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="64" Brush="ButtonBrush1"
                                              Command.Click="ExecutePlus" UpdateChildrenStates="true">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="20" Text="+" />
                                  </Children>
                                </ButtonWidget>
                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="34" SuggestedHeight="32"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="14" Brush="ButtonBrush1"
                                              Command.Click="ExecuteRemove" UpdateChildrenStates="true">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="20" Text="×" />
                                  </Children>
                                </ButtonWidget>
                              </Children>
                            </Widget>
                          </ItemTemplate>
                        </ListPanel>
                      </Children>
                    </Widget>
                  </Children>
                </ScrollablePanel>
                <ScrollbarWidget Id="PlanBar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="8"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="10" MarginBottom="10" MarginRight="2"
                                 AlignmentAxis="Vertical" Handle="PlanBarHandle" MaxValue="100" MinValue="0">
                  <Children>
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2" HorizontalAlignment="Center"
                            Sprite="BlankWhiteSquare" Color="#5A4033FF" AlphaFactor="0.3" />
                    <ImageWidget Id="PlanBarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedHeight="10" SuggestedWidth="6"
                                 HorizontalAlignment="Center" Brush="FaceGen.Scrollbar.Handle" Brush.AlphaFactor="0.7" />
                  </Children>
                </ScrollbarWidget>
              </Children>
            </Widget>

            <!-- ===== 底部按钮区 ===== -->
            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom" MarginLeft="26" MarginBottom="26"
                       StackLayout.LayoutMethod="VerticalTopToBottom">
              <Children>

                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <Children>
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="150" SuggestedHeight="42"
                                  Brush="ButtonBrush2" Command.Click="ExecuteAdd" UpdateChildrenStates="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="20" Text="+ 添加建筑" />
                      </Children>
                    </ButtonWidget>
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="92" SuggestedHeight="42"
                                  MarginLeft="20" Brush="ButtonBrush1" Command.Click="ExecuteClear" UpdateChildrenStates="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="20" Text="清空" />
                      </Children>
                    </ButtonWidget>
                  </Children>
                </ListPanel>

                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MarginTop="12" StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <Children>
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="132" SuggestedHeight="42"
                                  Brush="ButtonBrush2" Command.Click="ExecutePreset1" UpdateChildrenStates="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="18" Text="@Preset1" />
                      </Children>
                    </ButtonWidget>
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="132" SuggestedHeight="42"
                                  MarginLeft="16" Brush="ButtonBrush2" Command.Click="ExecutePreset2" UpdateChildrenStates="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="18" Text="@Preset2" />
                      </Children>
                    </ButtonWidget>
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="132" SuggestedHeight="42"
                                  MarginLeft="16" Brush="ButtonBrush2" Command.Click="ExecutePreset3" UpdateChildrenStates="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="18" Text="@Preset3" />
                      </Children>
                    </ButtonWidget>
                  </Children>
                </ListPanel>

                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MarginTop="12" StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <Children>
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="172" SuggestedHeight="42"
                                  Brush="ButtonBrush1" Command.Click="ExecuteUndo" UpdateChildrenStates="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="20" Text="撤销(Ctrl+Z)" />
                      </Children>
                    </ButtonWidget>
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="172" SuggestedHeight="42"
                                  MarginLeft="20" Brush="ButtonBrush2" Command.Click="ExecuteClose" UpdateChildrenStates="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MapTextBrushGal" Brush.FontSize="20" Text="退出建造模式" />
                      </Children>
                    </ButtonWidget>
                  </Children>
                </ListPanel>

              </Children>
            </ListPanel>

          </Children>
        </BrushWidget>

      </Children>
    </Widget>
  </Window>
</Prefab>
