                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                            HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="154" MarginTop="47"
                            Brush="MapTextBrushGal" Brush.FontSize="40" Brush.FontColor="#E8C33AFF" Text="文化" />
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                            HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="246" MarginTop="61"
                            Brush="MapTextBrushGal" Brush.FontSize="19" Brush.FontColor="#C8B98FCC"
                            Text="每个文化一部法律 · 效果作用于同化/迁移/满意度/税收/忠诚" />
                <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="64" SuggestedHeight="48"
                        HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="1616" MarginTop="50"
                        Brush="Fia.Button">
