                  <ItemTemplate>
                    <Widget WidthSizePolicy="Fixed" SuggestedWidth="672" HeightSizePolicy="Fixed" SuggestedHeight="46"
                            PositionXOffset="0" PositionYOffset="@IdxOffset" Sprite="@Plate">
                      <Children>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="26" SuggestedHeight="26"
