                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                            HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="76" MarginTop="152"
                            Brush="MapTextBrushGal" Brush.FontSize="21" Brush.FontColor="#E8D9B0FF" Text="@Top1" />
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="660" SuggestedHeight="64"
                        HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="674" MarginTop="130" Sprite="fia_ui_row" />
