                                    Brush="MapTextBrushGal" Brush.FontSize="17" Brush.FontColor="#A08F6CFF" Text="@ShareText" />
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="16"
                                    Brush="MapTextBrushGal" Brush.FontSize="17" Brush.FontColor="@LawColor" Text="@LawText" />
                      </Children>
                    </Widget>
                  </ItemTemplate>
