                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" VerticalAlignment="Top"
                                Sprite="BlankWhiteSquare" Color="@FrameColor" />
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" VerticalAlignment="Bottom"
                                Sprite="BlankWhiteSquare" Color="@FrameColor" />
                        <Widget WidthSizePolicy="Fixed" SuggestedWidth="2" HeightSizePolicy="StretchToParent" HorizontalAlignment="Left"
                                Sprite="BlankWhiteSquare" Color="@FrameColor" />
                        <Widget WidthSizePolicy="Fixed" SuggestedWidth="2" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right"
                                Sprite="BlankWhiteSquare" Color="@FrameColor" />
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="18" MarginTop="12"
                                    Brush="MapTextBrushGal" Brush.FontSize="21" Brush.FontColor="#E8D9B0FF" Text="@Name" />
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="18" MarginTop="44"
                                    Brush="MapTextBrushGal" Brush.FontSize="16" Brush.FontColor="#A08F6CFF" Text="@Desc" />
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="18" MarginTop="68"
                                    Brush="MapTextBrushGal" Brush.FontSize="16" Brush.FontColor="#8FD8E8CC" Text="@Effect" />
                      </Children>
