                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="46"
                                    Brush="MapTextBrushGal" Brush.FontSize="19" Brush.FontColor="#E8D9B0FF" Text="@Name" />
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="330"
                                    Brush="MapTextBrushGal" Brush.FontSize="17" Brush.FontColor="#D8C9A0FF" Text="@PopText" />
